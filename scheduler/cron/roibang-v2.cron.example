# RoiBang-v2 Phase 1 scheduler example.
# Review before installing. This file is not installed by the renderer.
# Create logs/scheduler before enabling these entries.

# roibang-project-schedule-restore-due - RoiBang-v2 项目时段到期恢复 [Asia/Shanghai]
10 0 * * * cd /Users/hongen/Projects/RoiBang-v2 && mkdir -p logs/scheduler && PYTHONPATH=src python3 scripts/run_scheduler_job.py --registry configs/scheduler/roibang-v2.jobs.example.json --job-id roibang-project-schedule-restore-due --repo-root /Users/hongen/Projects/RoiBang-v2 >> logs/scheduler/roibang-project-schedule-restore-due.out.log 2>> logs/scheduler/roibang-project-schedule-restore-due.err.log

