<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.roibang.v2.roibang-material-kind-reconcile</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-lc</string>
		<string>cd /tmp &amp;&amp; mkdir -p /Users/hongen/Projects/RoiBang-v2/logs/scheduler &amp;&amp; PYTHONPATH=/Users/hongen/Projects/RoiBang-v2/src /Library/Frameworks/Python.framework/Versions/3.11/bin/python3 /Users/hongen/Projects/RoiBang-v2/scripts/run_scheduler_job.py --registry /Users/hongen/Projects/RoiBang-v2/configs/scheduler/roibang-v2.jobs.example.json --job-id roibang-material-kind-reconcile --repo-root /Users/hongen/Projects/RoiBang-v2 &gt;&gt; /Users/hongen/Projects/RoiBang-v2/logs/scheduler/roibang-material-kind-reconcile.out.log 2&gt;&gt; /Users/hongen/Projects/RoiBang-v2/logs/scheduler/roibang-material-kind-reconcile.err.log</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/hongen/Projects/RoiBang-v2/logs/scheduler/roibang-material-kind-reconcile.launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/hongen/Projects/RoiBang-v2/logs/scheduler/roibang-material-kind-reconcile.launchd.err.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
</dict>
</plist>
