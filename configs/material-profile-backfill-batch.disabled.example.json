{
  "material_profile_backfill_batch": {
    "max_batches": 1,
    "stop_on_no_progress": true,
    "run_duplicate_analysis": true,
    "material_profile_sync": {
      "kind": "openapi_video_materials",
      "enabled": false,
      "account_source": "material_daily_metrics",
      "lookup_mode": "missing_material_ids",
      "lookup_accounts_from": "material_daily_metrics",
      "source_accounts": [],
      "endpoint_sequence": [
        "ebp_video_material_get",
        "video_material_get",
        "material_attributes_list"
      ],
      "account_type": "AD",
      "return_lowquality_suggestions": true,
      "date_range": {
        "start": "2026-02-10",
        "end": "2026-05-06"
      },
      "page_size": 100,
      "material_id_chunk_size": 100,
      "limits": {
        "max_accounts": 3,
        "max_pages": 20
      },
      "skip_profiled_materials": true,
      "retry_api_codes": ["50000"],
      "max_api_retries": 2,
      "retry_sleep_seconds": 2,
      "openapi_http": {
        "enabled": false,
        "token_store": {
          "enabled": true,
          "store_file": "data/secrets/oceanengine-tokens.local.json",
          "user_id": "default",
          "app_id_env": "OCEANENGINE_APP_ID",
          "app_secret_env": "OCEANENGINE_APP_SECRET",
          "auto_refresh": true,
          "refresh_lead_seconds": 900
        },
        "timeout_seconds": 30,
        "max_retries": 2,
        "retry_sleep_seconds": 2,
        "min_interval_seconds": 0.2,
        "response_audit_dir": "data/runs/openapi_http/material-profile-backfill-batch"
      }
    },
    "material_duplicate_analysis": {
      "rules": ["signature"],
      "min_group_size": 2
    }
  }
}
