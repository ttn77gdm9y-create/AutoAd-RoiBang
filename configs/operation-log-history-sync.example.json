{
  "operation_log_history_sync": {
    "product_keyword": "勇者突进",
    "operation_log_page_size": 20,
    "window_days": 3,
    "openapi_http": {
      "enabled": false,
      "token_store": {
        "enabled": true,
        "store_file": "data/secrets/oceanengine-tokens.local.json",
        "user_id": "default",
        "auto_refresh": true,
        "refresh_lead_seconds": 900,
        "credentials_file": "data/secrets/oceanengine-app.local.json"
      },
      "timeout_seconds": 20,
      "max_retries": 3,
      "retry_api_codes": [50000, 51010],
      "max_api_retries": 3,
      "retry_sleep_seconds": 3,
      "min_interval_seconds": 0.2,
      "retry_statuses": [429, 500, 502, 503, 504],
      "response_audit_dir": "data/runs/openapi_http/operation-log-history"
    },
    "execution": {
      "status": "planned_only",
      "external_api_enabled": false
    }
  }
}
